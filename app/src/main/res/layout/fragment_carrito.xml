<?xml version="1.0" encoding="utf-8"?>
<!--
    Fragmento Carrito (requisito "Botones"): muestra el uso de Button,
    ImageButton, Switch, RadioButton y CheckBox.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvTituloCarrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/carrito_titulo"
            android:textColor="@color/negro"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Aquí se agregan las filas de productos desde el código -->
        <LinearLayout
            android:id="@+id/contenedorItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvCarritoVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/carrito_vacio"
            android:textColor="@color/gris_texto" />

        <LinearLayout
            android:id="@+id/panelPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_tarjeta"
            android:orientation="vertical"
            android:padding="10dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swExpress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/envio_express" />

            <TextView
                style="@style/TituloSeccion"
                android:layout_marginTop="6dp"
                android:text="@string/metodo_pago" />

            <RadioGroup
                android:id="@+id/rgPago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbTarjeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/pago_tarjeta" />

                <RadioButton
                    android:id="@+id/rbPse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pago_pse" />

                <RadioButton
                    android:id="@+id/rbContraentrega"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pago_contraentrega" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/cbTerminosCompra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/acepto_terminos" />

            <TextView
                android:id="@+id/tvSubtotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end" />

            <TextView
                android:id="@+id/tvEnvio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/morado"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnVaciar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/btn_vaciar" />

                <Button
                    android:id="@+id/btnFinalizar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:text="@string/btn_finalizar" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
