<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla principal: dos fragmentos en la misma pantalla.
    Izquierda: menú de opciones (MenuFragment).
    Derecha: contenido de la opción seleccionada.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/contenedorMenu"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:background="@color/morado_claro" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/borde" />

    <FrameLayout
        android:id="@+id/contenedorContenido"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
