<?xml version="1.0" encoding="utf-8"?>
<!--
    Fragmento Catálogo (requisito "Fotos"): lista de imágenes con barra
    de desplazamiento. Al seleccionar una se muestra su descripción.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <EditText
        android:id="@+id/etBuscar"
        style="@style/CajaTexto"
        android:drawableStart="@drawable/ic_search"
        android:hint="@string/hint_buscar"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1" />

    <Spinner
        android:id="@+id/spCategorias"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvAyudaCatalogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/toca_producto"
        android:textColor="@color/gris_texto"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/lvProductos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:divider="@color/gris_borde"
        android:dividerHeight="1dp"
        android:fadeScrollbars="false"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/tvCatalogoVacio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/catalogo_vacio"
        android:textColor="@color/gris_texto"
        android:visibility="gone" />

    <!-- Panel con la descripción del producto seleccionado -->
    <LinearLayout
        android:id="@+id/panelDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_tarjeta"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivDetalle"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_icono_producto"
                android:contentDescription="@string/descripcion_imagen"
                android:padding="4dp"
                android:scaleType="fitCenter"
                />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetalleNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/negro"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetallePrecio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/morado"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetalleEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCerrarDetalle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/descripcion_imagen"
                android:src="@drawable/ic_close"
                app:tint="@color/gris_texto" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetalleDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="4"
            android:scrollbars="vertical"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAgregarCarrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_agregar_carrito" />
    </LinearLayout>
</LinearLayout>
