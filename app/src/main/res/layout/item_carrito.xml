<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del carrito con botones para cambiar cantidad y eliminar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_tarjeta"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/ivItemCarrito"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_icono_producto"
        android:contentDescription="@string/descripcion_imagen"
        android:padding="3dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/negro"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtotalItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/morado_oscuro"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMenos"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_input"
                android:contentDescription="@string/descripcion_imagen"
                android:src="@drawable/ic_remove"
                app:tint="@color/morado" />

            <TextView
                android:id="@+id/tvCantidad"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMas"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_input"
                android:contentDescription="@string/descripcion_imagen"
                android:src="@drawable/ic_add"
                app:tint="@color/morado" />

            <ImageButton
                android:id="@+id/btnEliminar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/descripcion_imagen"
                android:src="@drawable/ic_delete"
                app:tint="@color/rojo" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
