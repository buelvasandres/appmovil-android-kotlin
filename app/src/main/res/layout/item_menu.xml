<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño de cada opción del menú izquierdo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_menu_item"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="36dp">

        <ImageView
            android:id="@+id/ivIconoMenu"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@string/descripcion_imagen"
            app:tint="@color/morado_oscuro" />

        <TextView
            android:id="@+id/tvContadorMenu"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_contador"
            android:gravity="center"
            android:textColor="@color/blanco"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTextoMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/morado_oscuro"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
