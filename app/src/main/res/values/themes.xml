<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema principal: barra superior morada -->
    <style name="Theme.CatalogoExpress" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/morado</item>
        <item name="colorPrimaryVariant">@color/morado_oscuro</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/morado</item>
        <item name="colorSecondaryVariant">@color/morado_oscuro</item>
        <item name="colorOnSecondary">@color/blanco</item>
        <item name="android:statusBarColor">@color/morado_oscuro</item>
    </style>

    <!-- Tema sin barra superior para login y registro -->
    <style name="Theme.CatalogoExpress.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Estilo de las cajas de texto -->
    <style name="CajaTexto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">@color/gris_texto</item>
    </style>

    <!-- Títulos de sección -->
    <style name="TituloSeccion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/morado_oscuro</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
</resources>
